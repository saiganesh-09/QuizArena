# ──────────────────────────────────────────────────────────────
# QuizArena Backend — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values for your environment.
# Never commit the real `.env` file to version control.

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────
# MongoDB connection string. Use a local instance for development.
# In production, use a managed MongoDB Atlas URI or your own cluster.
MONGO_URI=mongodb://127.0.0.1:27017/quizarena

# ── Auth / JWT ────────────────────────────────────────────────
# A long, random secret string used to sign JWTs.
# Generate one with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-secret-string

# JWT expiration (e.g. "1d", "7d", "12h", "3600s").
JWT_EXPIRES_IN=1d

# The name of the HTTP-only cookie that holds the JWT.
JWT_COOKIE_NAME=qa_token

# ── Cookie Security ───────────────────────────────────────────
# Set to true in production (requires HTTPS).
COOKIE_SECURE=false

# SameSite attribute: "none" (cross-site, requires Secure),
# "lax" (default, same-site GET), or "strict" (same-site only).
COOKIE_SAMESITE=lax

# Optional domain restriction for the cookie (e.g. ".example.com").
# Leave empty for localhost.
COOKIE_DOMAIN=

# ── CORS ──────────────────────────────────────────────────────
# The origin of the frontend client.
CLIENT_ORIGIN=http://localhost:5173

# ── Bcrypt ────────────────────────────────────────────────────
# Bcrypt cost factor (higher = more secure but slower).
# Default is 12 (good for production). Range: 4–31.
BCRYPT_COST=12
